{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-server",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": ["server", "src/types.ts"]
}
